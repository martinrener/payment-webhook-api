        {"name": "DB_USERNAME", "value": "laravel"},
        {"name": "DB_PASSWORD", "value": "secret1234"},
        {"name": "APP_ENV", "value": "production"},
        {"name": "APP_DEBUG", "value": "false"},
        {"name": "APP_KEY", "value": "base64:Ushb76E+CMq6SGVRrvWa52w9nJBX8Y8DvI0iolk9dY8="},
        {"name": "QUEUE_CONNECTION", "value": "database"},
        {"name": "DB_CONNECTION", "value": "mysql"},
        {"name": "CACHE_STORE", "value": "array"},
        {"name": "BROADCAST_CONNECTION", "value": "reverb"},
        {"name": "REVERB_APP_KEY", "value": "kdlyfjwapt2e7ezd8bjc"},
        {"name": "REVERB_APP_SECRET", "value": "reverb_secret_2026"},
        {"name": "REVERB_APP_ID", "value": "1"},
        {"name": "REVERB_HOST", "value": "payment-webhook-reverb-nlb-34b0ab443285c8fb.elb.us-east-1.amazonaws.com"},
