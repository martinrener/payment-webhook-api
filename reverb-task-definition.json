{
  "family": "payment-webhook-reverb",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::125482556623:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::125482556623:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "reverb",
      "image": "125482556623.dkr.ecr.us-east-1.amazonaws.com/payment-webhook-api:latest",
      "command": ["php", "artisan", "reverb:start", "--host=0.0.0.0"],
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "DB_HOST", "value": "payment-webhook-db.cu9iu8e4glvg.us-east-1.rds.amazonaws.com"},
        {"name": "DB_DATABASE", "value": "payment_webhook"},
        {"name": "DB_USERNAME", "value": "laravel"},
        {"name": "DB_PASSWORD", "value": "REPLACE_ME"},
        {"name": "APP_ENV", "value": "production"},
        {"name": "APP_DEBUG", "value": "false"},
        {"name": "APP_KEY", "value": "REPLACE_ME"},
        {"name": "REVERB_HOST", "value": "0.0.0.0"},
        {"name": "REVERB_PORT", "value": "8080"},
        {"name": "CACHE_STORE", "value": "array"},
        {"name": "DB_CONNECTION", "value": "mysql"},
        {"name": "REVERB_APP_KEY", "value": "REPLACE_ME"},
        {"name": "REVERB_APP_SECRET", "value": "REPLACE_ME"},
        {"name": "REVERB_APP_ID", "value": "1"}
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payment-webhook-reverb",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}