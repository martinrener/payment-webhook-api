{
  "family": "payment-webhook-app-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::125482556623:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::125482556623:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "125482556623.dkr.ecr.us-east-1.amazonaws.com/payment-webhook-api:latest",
      "command": ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"],
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "DB_HOST", "value": "payment-webhook-db.cu9iu8e4glvg.us-east-1.rds.amazonaws.com"},
        {"name": "DB_DATABASE", "value": "payment_webhook_dev"},
        {"name": "DB_USERNAME", "value": "laravel"},
        {"name": "DB_PASSWORD", "value": "secret1234"},
        {"name": "APP_ENV", "value": "local"},
        {"name": "APP_DEBUG", "value": "true"},
        {"name": "APP_KEY", "value": "base64:Ushb76E+CMq6SGVRrvWa52w9nJBX8Y8DvI0iolk9dY8="},
        {"name": "DB_CONNECTION", "value": "mysql"},
        {"name": "QUEUE_CONNECTION", "value": "database"},
        {"name": "APP_URL", "value": "http://payment-webhook-alb-dev-2133156852.us-east-1.elb.amazonaws.com"}
      ],
      "essential": true,
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/payment-webhook-app-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
